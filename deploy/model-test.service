[Unit]
Description=Model Test Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=model-test
Group=model-test
WorkingDirectory=/opt/model-test/current/backend
EnvironmentFile=/etc/model-test/platform.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/model-test/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/model-test/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8032 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/model-test

[Install]
WantedBy=multi-user.target
